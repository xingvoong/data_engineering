# GitHub
GITHUB_TOKEN=your_github_token_here

# MinIO (S3-compatible storage for Iceberg)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=warehouse

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=github_pulse
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# dlt
DESTINATION__FILESYSTEM__BUCKET_URL=s3://warehouse
DESTINATION__FILESYSTEM__CREDENTIALS__ENDPOINT_URL=http://localhost:9000
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_ACCESS_KEY_ID=minioadmin
DESTINATION__FILESYSTEM__CREDENTIALS__AWS_SECRET_ACCESS_KEY=minioadmin
